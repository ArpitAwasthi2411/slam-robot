# Copy to robot.env in the same folder (~/pathik/robot.env). Never commit robot.env (it has keys).

# Launch arguments, exactly as with `ros2 launch lidar_robot bringup.launch.py ...`
# Serial ports: plain names work best on this robot (see the lab notes)
ROBOT_ARGS=esp32_port:=/dev/ttyUSB1 lidar_port:=/dev/ttyUSB0
# Drive on a saved map instead of mapping:
# ROBOT_ARGS=esp32_port:=/dev/ttyUSB1 lidar_port:=/dev/ttyUSB0 slam_mode:=localization map:=/root/maps/cse_floor.pbstream

# Language model for commands (optional; without it the offline parser is used)
# GROQ_API_KEY=gsk_...

# Which image version runs is kept in ~/pathik/.env (PATHIK_TAG=...), written by pathik.sh.
