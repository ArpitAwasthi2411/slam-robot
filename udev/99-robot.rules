# Stable device names for the robot. Install on the Pi with:  sudo ./scripts/install_udev.sh
# After this:  /dev/rplidar  and  /dev/esp32  always point to the right device,
# no matter which USB port or plug-in order.

# RPLiDAR A1M8 (Silicon Labs CP2102 USB-UART adapter)
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="rplidar", MODE="0666"

# ESP32-S3 native USB port (Espressif VID 303a) — shows up as /dev/ttyACM*
# ID_MM_DEVICE_IGNORE stops ModemManager from probing it with AT commands.
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", SYMLINK+="esp32", MODE="0666", ENV{ID_MM_DEVICE_IGNORE}="1"

# ---- Classic ESP32 DevKit (no native USB; a USB-UART chip shows up as /dev/ttyUSB*) ----
# Check which chip your board has:  lsusb   (or: udevadm info -q property -n /dev/ttyUSB1 | grep ID_)
#
# a) CH340 / CH9102 chip -> different from the LiDAR's CP2102, just uncomment:
# SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", SYMLINK+="esp32", MODE="0666"
# SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d4", SYMLINK+="esp32", MODE="0666"
#
# b) CP2102 chip (same as the RPLiDAR!) -> VID/PID can't tell them apart (and the RPLiDAR rule
#    above would name BOTH "rplidar"). Match by the physical Pi USB socket instead, and always
#    plug each device into the same socket. Get each socket's path with:
#       udevadm info -q property -n /dev/ttyUSB0 | grep ID_PATH=
#    then comment out the RPLiDAR VID/PID rule above and use, e.g.:
# SUBSYSTEM=="tty", ENV{ID_PATH}=="platform-fd500000.pcie-pci-0000:01:00.0-usb-0:1.3:1.0", SYMLINK+="rplidar", MODE="0666"
# SUBSYSTEM=="tty", ENV{ID_PATH}=="platform-fd500000.pcie-pci-0000:01:00.0-usb-0:1.4:1.0", SYMLINK+="esp32", MODE="0666"
